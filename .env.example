# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_NAME=helpdeskWS
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ── Aplicação ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=uma_chave_secreta_longa_e_aleatoria
JWT_ACCESS_TOKEN_EXPIRES=28800
EMAIL_SERVICE_ENABLED=true

# Origens liberadas pro CORS, separadas por vírgula (ex: https://chamados.consominas.com.br).
# Sem essa variável, NENHUMA origem é liberada (falha segura).
CORS_ALLOWED_ORIGINS=

# Teto de tamanho de corpo de requisição aceito pelo Flask, em bytes (padrão 200MB).
MAX_CONTENT_LENGTH_BYTES=209715200

# Chave usada pra cifrar/decifrar credenciais em repouso (SMTP/IMAP hoje, tokens
# OAuth do módulo de gestão depois). Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA versionar o valor real — só este placeholder.
FERNET_KEY=

# ── E-mail IMAP ───────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASSWORD=sua_senha_email

# ── E-mail SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=sua_senha_email

# ── Integração Senior (Sapiens G5) — módulo Financeiro / Conferência de OC ──
# Usuário de serviço do dispatcher Sapiens, usado pra consultar Ordens de
# Compra (E420OCP) ao vivo via GetDBInfo. Diferente do Suprimentos (que recebe
# dados via n8n), este módulo chama a Senior direto — ver
# backend/integrations/senior/senior_client.py.
SENIOR_WS_SAPIENS_USER=
SENIOR_WS_SAPIENS_PASSWORD=
SENIOR_SAPIENS_DB_URL=https://web01s1p.seniorcloud.com.br:30901/g5-senior-services/sapiens_Synccom_senior_g5_co_ger_db

# Tabela/colunas do cadastro de fornecedores — ainda não confirmadas neste
# tenant (ver knowledge doc do projeto). Sem preencher, a tela de Conferência
# de OC mostra o número do fornecedor sem nome/UF.
SENIOR_FORNECEDOR_TABELA=
SENIOR_FORNECEDOR_COL_CODIGO=CODFOR
SENIOR_FORNECEDOR_COL_NOME=NOMFOR
SENIOR_FORNECEDOR_COL_UF=UF
